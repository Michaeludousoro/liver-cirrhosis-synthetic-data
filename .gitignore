# Virtual environment — never commit
venv/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Jupyter checkpoint folders
.ipynb_checkpoints/

# macOS system files
.DS_Store
.AppleDouble
.LSOverride

# Pickle files — platform-specific, not portable
*.pkl
*.h5

# Editor settings
.vscode/
.idea/
*.swp
*.swo

# Large intermediate data files that are regenerated by the notebooks
output/data/

# Claude Code session data
.claude/

# Word build artifact
paper/*.docx

meeting_brief.pdf

latest.pdf
final_*.pdf
compiled.pdf

# Compiled PDFs dropped in the project root for inspection
/*.pdf

# Build scratch — regenerable working files, not deliverables
tmp/
revisions/*/qa/
revisions/**/*.aux
revisions/**/*.bbl
revisions/**/*.blg
revisions/**/*.log
revisions/**/*.out
revisions/**/*.synctex
revisions/**/*.synctex.gz
revisions/**/*.fls
revisions/**/*.fdb_latexmk
revisions/**/build-*.log
